[app:sys/gdu]
cmd  = gdu
desc = Disk usage overview

[app:sys/btop]
cmd  = btop
desc = Task manager

[app:sys/dust]
cmd  = dust
desc = Disk usage overview

[app:sys/nvtop]
cmd  = nvtop 
