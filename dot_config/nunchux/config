[settings]
icon_running = ●
icon_stopped = ○

menu_width = 60%
menu_height = 50%
popup_width = 90%
popup_height = 90%

# Apps for ai usage
[menu:ai]
desc = Tools for ai usage

[app:ai/copilot]
cmd  = copilot --banner --allow-all-paths
desc = Check current ping

# Apps for alternate shells
[menu:sh]
desc = Tools for alternate shells

[app:sh/pwsh]
cmd  = pwsh
desc = Launch powershell

# Apps for monitoring the network
[menu:net]
desc = Network monitoring

[app:net/gping]
cmd  = gping 9.9.9.9
desc = Check current ping

[app:net/bandwhich]
cmd  = bandwhich
desc = Bandwidth by process

[app:net/speedtest]
cmd  = speedtest
desc = Test current speed

# Apps for secrets management
[menu:sec]
desc = Secrets management

[app:sec/gpg]
cmd  = gpg-tui
desc = Key management tui for gpg

[app:sec/pass]
cmd  = passepartui
desc = Password management tui

