# Apps for interacting with the web
[menu:web]
desc = Web interacting tools

[app:web/posting]
cmd  = posting
desc = Client for rest requests

# Apps for interacting with repositories
[menu:repo]
desc = Repository browsing

[app:repo/gi]
cmd    = gi
desc   = Commit emoji picker
status = n=$(git status -s 2>/dev/null | wc -l | tr -d ' '); [[ $n -gt 0 ]] && echo "($n changed)"

[app:repo/tgr]
cmd    = tgr
desc   = Explore github repos
status = n=$(git status -s 2>/dev/null | wc -l | tr -d ' '); [[ $n -gt 0 ]] && echo "($n changed)"

[app:repo/tig]
cmd    = tig
desc   = Repo management tui
status = n=$(git status -s 2>/dev/null | wc -l | tr -d ' '); [[ $n -gt 0 ]] && echo "($n changed)"

[app:repo/lazygit]
cmd    = GIT_EDITOR='meteor --skip-intro --as-git-editor' lazygit
desc   = Repo management tui
status = n=$(git status -s 2>/dev/null | wc -l | tr -d ' '); [[ $n -gt 0 ]] && echo "($n changed)"

[app:repo/gitlogue]
cmd    = gitlogue --loop --commit $(git symbolic-ref refs/remotes/origin/HEAD | sed "s@.*/@@")..$(git rev-parse --abbrev-ref HEAD)'
desc   = Replay code changes
status = n=$(git status -s 2>/dev/null | wc -l | tr -d ' '); [[ $n -gt 0 ]] && echo "($n changed)"

[app:repo/gh-dash]
cmd  = gh-dash
desc = Repo management tui for github

[app:repo/gh-notify]
cmd  = gh-notify
desc = Notification management tui for github

# Apps for todos and note taking
[menu:todo]
desc = Tools for checking todos

[app:todo/calcurse]
cmd  = calcurse
desc = Calendar tui

