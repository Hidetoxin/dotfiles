# Import public `gpg` key
% gpg, key, public
gpg --import '<pubic_key>'

# Import private `gpg` key
% gpg, key,private
gpg --allow-secret-key-import --import '<private_key'

# Create new `gpg` key
% gpg, key
gpg --quick-gen-key --batch --passphrase '' '<email>'

# List secret keys
% gpg, key
gpg --list-secret-keys --keyid-format='long'

# Export `gpg` public key
% gpg, key, public
gpg --armor --export '<id>' | pbcopy

# Export `gpg` private key
% gpg, pbcopy, private
gpg --armor --export-secret-keys '<id>' | pbcopy

# Fix `gpg` permissions
% gpg, find, chmod
chown --recursive "$(whoami)" "${GNUPGHOME}" \
    && find "${GNUPGHOME}" -type f -exec chmod 600 {} \; \
    && find "${GNUPGHOME}" -type d -exec chmod 700 {} \;

# vim: et ts=4 sts=4 sw=4 syntax=sh
