# View all `jira` issues assigned to me
% jira, issues, me
jira issue list --status '~Done' --assignee "$(jira me)"

# View all un-assigned `jira` issues
%jira, issues, todo
jira issue list --jql "assignee IS EMPTY AND status = 'To Do'"

# Coment a `jira` issue assigned to me
$ issue: jira issue list --plain --status '~Done' --columns 'key' --assignee "$(jira me)" | fzf --prompt 'jira issue  ' --header 'Choose an issue' --preview 'jira issue view {}'
% jira, issues, comment
jira issue comment add '<issue>'

# vim: et ts=4 sts=4 sw=4 syntax=sh
